Порядок запуска:
1. ServiceRegistryApplication
2. BootAdminServerApplication
3. IngredientServiceApplication
4. IngredientClientApplication

IngredientClientApplication Профили:
1. Без указания профиля запустится RestTemplate
2. Feign запустится Feign
3. Webclient запустится WebFlux


create docker
1. ./mvnw package dockerfile:build
with plugin in pom.xml
<plugin>
    <groupId>com.spotify</groupId>
    <artifactId>dockerfile-maven-plugin</artifactId>
    <version>1.4.13</version>
    <configuration>
        <repository>${docker.image.prefix}/${project.artifactId}</repository>
        <buildArgs>
            <JAR_FILE>target/${project.build.finalName}.jar</JAR_FILE>
        </buildArgs>
    </configuration>
</plugin>

2. ./mvnw spring-boot:build-image -Dspring-boot.build-image.imageName=tacocloud/boot-admin-server:0.0.19-SNAPSHOT
works only with jdk 17

3. docker build tacocloud -t habuma/tacocloud:0.0.19-SNAPSHOT
docker build . -t tacocloud/ingredient-service:0.0.19-SNAPSHOT
docker build . -t tacocloud/ingredient-client:0.0.19-SNAPSHOT
docker build . -t tacocloud/boot-admin-service:0.0.19-SNAPSHOT
docker build . -t tacocloud/service-registry:0.0.19-SNAPSHOT

docker run -d -p 8761:8761 --name service-registry tacocloud/service-registry:0.0.19-SNAPSHOT
docker run -d -p 9090:9090 --name boot-admin --link service-registry:eureka tacocloud/boot-admin-server:0.0.19-SNAPSHOT
docker run -d -p 8888:8888 --name ingredient-service --link service-registry:eureka --link boot-admin:boot-admin  tacocloud/ingredient-service:0.0.19-SNAPSHOT
docker run -d -p 8080:8080 --name ingredient-client --link service-registry:eureka --link boot-admin:boot-admin --link ingredient-service:ingredient-service  tacocloud/ingredient-client:0.0.19-SNAPSHOT








